             m_wmemory = reusable_region.writable_memory;
+            m_uses_permanent_jit_region = m_memory == m_wmemory;
             reusable_region.in_use = true;
         } else {
+            // Chimera/AppSync can preserve dynamic-codesigning without
+            // attaching the special debugger expected by Oaknut. Prefer a
+            // normal mapping whose protection we toggle between RW and RX.
+            m_memory = detail::prepare_permanent_jit_region(size);
+            if (m_memory != nullptr) {
+                m_wmemory = m_memory;
+                m_uses_permanent_jit_region = true;
+                reusable_region = {m_memory, m_wmemory, size, true};
+                return;
