+// Jailbroken iOS 12 can allow dynamically generated code without an AltJIT
+// debugger being present to service the brk protocol below. Keep the mapping
+// writable while Dynarmic emits code, then switch it to executable in
+// CodeBlock::protect(). This avoids requiring simultaneous W+X permission.
+inline std::uint32_t* prepare_permanent_jit_region(std::size_t size)
+{
+    void* mapping = mmap(nullptr,
+                         size,
+                         PROT_READ | PROT_WRITE,
+                         MAP_ANON | MAP_PRIVATE,
+                         -1,
+                         0);
+    if (mapping == MAP_FAILED)
+        return nullptr;
+
+    return static_cast<std::uint32_t*>(mapping);
+}
+
 __attribute__((noinline, optnone, naked)) static void* prepare_jit_region(void*, std::size_t)
 {
     __asm__ volatile(
@@ -77,7 +95,19 @@ public:
