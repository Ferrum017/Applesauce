+// AltJIT-style debuggers allocate executable memory by handling the
+// brk #0xf00d protocol below.  A jailbroken iOS 12 process carrying the
+// dynamic-codesigning entitlement does not have such a debugger attached,
+// however: it can allocate executable memory itself.  Prefer that path when
+// the kernel really grants execute permission, and fall back to the debugger
+// protocol otherwise.
+//
+// Checking mmap's returned pointer is not enough.  Require the kernel to
+// accept an explicit transition from writable memory to RWX.
+inline std::uint32_t* prepare_permanent_jit_region(std::size_t size)
+{
+    int flags = MAP_ANON | MAP_PRIVATE;
+#    if defined(MAP_JIT)
+    flags |= MAP_JIT;
+#    endif
+
+    void* mapping = mmap(nullptr, size, PROT_READ | PROT_WRITE, flags, -1, 0);
+    if (mapping == MAP_FAILED)
+        return nullptr;
+
+    if (mprotect(mapping, size, PROT_READ | PROT_WRITE | PROT_EXEC) != 0) {
+        munmap(mapping, size);
+        return nullptr;
+    }
+
+    return static_cast<std::uint32_t*>(mapping);
+}
+
 __attribute__((noinline, optnone, naked)) static void* prepare_jit_region(void*, std::size_t)
 {
     __asm__ volatile(
@@ -78,6 +106,16 @@ public:
             m_wmemory = reusable_region.writable_memory;
             reusable_region.in_use = true;
         } else {
+            // Chimera/AppSync can preserve dynamic-codesigning on iOS 12.
+            // In that configuration no debugger exists to service Oaknut's
+            // brk request, so use the directly executable mapping instead.
+            m_memory = detail::prepare_permanent_jit_region(size);
+            if (m_memory != nullptr) {
+                m_wmemory = m_memory;
+                reusable_region = {m_memory, m_wmemory, size, true};
+                return;
+            }
+
             m_memory = (std::uint32_t*)detail::prepare_jit_region(nullptr, size);
             if (m_memory == nullptr)
                 throw std::bad_alloc{};
